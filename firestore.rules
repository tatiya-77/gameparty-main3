rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ฟังก์ชันช่วยเหลือรวมเงื่อนไขสิทธิ์ไว้จุดเดียว เพื่อให้แต่ละ match ตรวจสอบด้วยหลักเกณฑ์เดียวกัน
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // สิทธิ์แอดมินมาจากการมีเอกสาร admins/{uid}; ผู้ใช้สร้างสิทธินี้จาก client ไม่ได้
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    function postHasOpenSlot(postData) {
      let limit = postData.get('maxPlayers', postData.get('slots', 5));
      let memberCount = postData.get('memberCount', 1);
      return postData.get('isRecruiting', true) == true
        && postData.get('joinStatus', 'open') == 'open'
        && (limit == null || (limit is int && memberCount is int && memberCount < limit));
    }

    function isGroupMember(groupId) {
      let groupPath = /databases/$(database)/documents/groupChats/$(groupId);
      return signedIn()
        && exists(groupPath)
        && (
          (
            get(groupPath).data.get('members', []) is list
            && request.auth.uid in get(groupPath).data.get('members', [])
          )
          || get(groupPath).data.get('ownerUid', '') == request.auth.uid
        );
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/privateChats/$(chatId);
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function postReactionPath(postId, userId) {
      return /databases/$(database)/documents/posts/$(postId)/reactions/$(userId);
    }

    function validPostReactionWrite(postId, userId) {
      return signedIn()
        && exists(postPath(postId))
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'reaction', 'eventId', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.reaction in [
          '', 'like', 'dislike', '❤️', '😂', '😮', '😢', '😡', '🔥', '🎮', '👏'
        ]
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.updatedAt == request.time;
    }

    function chatExists(chatId) {
      return exists(chatPath(chatId));
    }

    function isChatMember(chatId) {
      return signedIn()
        && chatExists(chatId)
        && get(chatPath(chatId)).data.members is list
        && request.auth.uid in get(chatPath(chatId)).data.members;
    }

    // Supports creating the chat room and its first message in one batch.
    function isChatMemberAfter(chatId) {
      return signedIn()
        && existsAfter(chatPath(chatId))
        && getAfter(chatPath(chatId)).data.members is list
        && request.auth.uid in getAfter(chatPath(chatId)).data.members;
    }

    function validVoteCount(oldCount, newCount, oldUsers, newUsers) {
      return (oldCount is int || oldCount is float)
        && (newCount is int || newCount is float)
        && newCount >= 0
        && newCount == oldCount
          + (request.auth.uid in newUsers ? 1 : 0)
          - (request.auth.uid in oldUsers ? 1 : 0);
    }

    function validEmojiState(emoji) {
      let oldReactions = resource.data.get('reactions', {});
      let newReactions = request.resource.data.get('reactions', {});
      let oldUsersByEmoji = resource.data.get('reactionUsers', {});
      let newUsersByEmoji = request.resource.data.get('reactionUsers', {});
      let oldUsers = oldUsersByEmoji.get(emoji, []);
      let newUsers = newUsersByEmoji.get(emoji, []);
      let oldCount = oldReactions.get(emoji, oldUsers.size());
      let newReaction = request.resource.data
        .get('reactionByUid', {}).get(request.auth.uid, '');

      return oldReactions is map
        && newReactions is map
        && oldUsersByEmoji is map
        && newUsersByEmoji is map
        && oldUsers is list
        && newUsers is list
        && newReactions.get(emoji, 0) is int
        && newUsers.size() == newUsers.toSet().size()
        && validVoteCount(
          oldCount,
          newReactions.get(emoji, 0),
          oldUsers,
          newUsers
        )
        && oldUsers.toSet().difference(newUsers.toSet())
          .hasOnly([request.auth.uid])
        && newUsers.toSet().difference(oldUsers.toSet())
          .hasOnly([request.auth.uid])
        && ((request.auth.uid in newUsers) == (newReaction == emoji));
    }

    function validPostReaction() {
      let oldLikedBy = resource.data.get('likedBy', []);
      let newLikedBy = request.resource.data.get('likedBy', []);
      let oldDislikedBy = resource.data.get('dislikedBy', []);
      let newDislikedBy = request.resource.data.get('dislikedBy', []);
      let oldReactionByUid = resource.data.get('reactionByUid', {});
      let newReactionByUid = request.resource.data.get('reactionByUid', {});
      let newReaction = newReactionByUid.get(request.auth.uid, '');
      let emojiKeys = ['❤️', '😂', '😮', '😢', '😡', '🔥', '🎮', '👏'];
      let reactionFields = [
        'likes', 'dislikes', 'likedBy', 'dislikedBy',
        'reactions', 'reactionUsers', 'reactionByUid'
      ];

      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(reactionFields)
        && oldLikedBy is list
        && newLikedBy is list
        && oldDislikedBy is list
        && newDislikedBy is list
        && newLikedBy.size() == newLikedBy.toSet().size()
        && newDislikedBy.size() == newDislikedBy.toSet().size()
        && oldLikedBy.toSet().difference(newLikedBy.toSet())
          .hasOnly([request.auth.uid])
        && newLikedBy.toSet().difference(oldLikedBy.toSet())
          .hasOnly([request.auth.uid])
        && oldDislikedBy.toSet().difference(newDislikedBy.toSet())
          .hasOnly([request.auth.uid])
        && newDislikedBy.toSet().difference(oldDislikedBy.toSet())
          .hasOnly([request.auth.uid])
        && validVoteCount(
          resource.data.get('likes', oldLikedBy.size()),
          request.resource.data.likes,
          oldLikedBy,
          newLikedBy
        )
        && validVoteCount(
          resource.data.get('dislikes', oldDislikedBy.size()),
          request.resource.data.dislikes,
          oldDislikedBy,
          newDislikedBy
        )
        && !newLikedBy.hasAny(newDislikedBy)
        && oldReactionByUid is map
        && newReactionByUid is map
        && newReactionByUid.diff(oldReactionByUid).affectedKeys()
          .hasOnly([request.auth.uid])
        && newReaction in ['', 'like', 'dislike', '❤️', '😂', '😮', '😢', '😡', '🔥', '🎮', '👏']
        && ((request.auth.uid in newLikedBy) == (newReaction == 'like'))
        && ((request.auth.uid in newDislikedBy) == (newReaction == 'dislike'))
        && validEmojiState('❤️')
        && validEmojiState('😂')
        && validEmojiState('😮')
        && validEmojiState('😢')
        && validEmojiState('😡')
        && validEmojiState('🔥')
        && validEmojiState('🎮')
        && validEmojiState('👏')
        && request.resource.data.get('reactionUsers', {}).diff(
          resource.data.get('reactionUsers', {})
        ).affectedKeys().hasOnly(emojiKeys)
        && request.resource.data.get('reactions', {}).diff(
          resource.data.get('reactions', {})
        ).affectedKeys().hasOnly(emojiKeys);
    }

    match /privateChats/{chatId} {
      // The arrayContains query in the app proves that the signed-in user is a member.
      // Do not require a fixed member count here: Firestore cannot prove that from that query.
      // Keep list authorization limited to the exact arrayContains membership
      // constraint used by the client query.
      allow get: if signedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members;

      allow list: if signedIn()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members.toSet().size() == 2
        && request.auth.uid in request.resource.data.members;

      allow update: if signedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMemberAfter(chatId)
          && request.resource.data.keys().hasAll([
            'uid', 'name', 'text', 'type', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'text', 'type', 'createdAt', 'mediaUrl', 'fileName'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.type in ['text', 'image', 'video']
          && (
            request.resource.data.type == 'text'
            || (
              request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
            )
          );

        allow update: if false;

        // Either participant can clear the shared conversation history.
        allow delete: if isChatMember(chatId);
      }
    }

    // ข้อมูลโปรไฟล์และ subcollections ส่วนตัว: inbox, join requests และ device tokens
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);

      // Private notification inbox. Only the recipient can read or manage it;
      // a chat participant may create a notice for the other room member.
      match /notifications/{notificationId} {
        allow get, list: if isOwner(uid);

        // Only admins may notify an account that its reported post was removed.
        allow create: if isAdmin()
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'type', 'body', 'postId', 'reportId', 'createdAt', 'isRead'
          ])
          && request.resource.data.type == 'post_removed'
          && request.resource.data.body == 'โพสต์ของคุณถูกลบหลังตรวจสอบรายงาน เนื่องจากมีเนื้อหาที่ไม่เหมาะสม'
          && request.resource.data.createdAt == request.time
          && request.resource.data.isRead == false
          && existsAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
          && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.status == 'deleted'
          && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.postId == request.resource.data.postId
          && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.postOwnerUid == uid;

        // Notify the post owner without including or encoding the reporter's UID.
        // This must be committed atomically with the matching private report.
        allow create: if signedIn()
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'type', 'postId', 'postTitle', 'body', 'createdAt', 'isRead'
          ])
          && request.resource.data.type == 'post_report'
          && request.resource.data.postId is string
          && request.resource.data.postTitle is string
          && request.resource.data.body == 'โพสต์ของคุณมีการถูกรายงาน ทีมงานจะตรวจสอบ'
          && request.resource.data.createdAt == request.time
          && request.resource.data.isRead == false
          && exists(postPath(request.resource.data.postId))
          && get(postPath(request.resource.data.postId)).data.uid == uid
          && existsAfter(/databases/$(database)/documents/reports/$(request.resource.data.postId + '_' + request.auth.uid))
          && !exists(/databases/$(database)/documents/reports/$(request.resource.data.postId + '_' + request.auth.uid))
          && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.postId + '_' + request.auth.uid)).data.postId == request.resource.data.postId
&& getAfter(/databases/$(database)/documents/reports/$(request.resource.data.postId + '_' + request.auth.uid)).data.reporterUid == request.auth.uid;
        allow create: if signedIn()
          && uid != request.auth.uid
          && request.resource.data.keys().hasAll([
            'type', 'senderUid', 'senderName', 'body', 'createdAt', 'isRead'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.body is string
          && request.resource.data.isRead == false
          && (
            (
              request.resource.data.keys().hasOnly([
                'type', 'chatId', 'senderUid', 'senderName', 'body', 'createdAt', 'isRead'
              ])
              && request.resource.data.type == 'chat_message'
              && request.resource.data.chatId is string
              && existsAfter(chatPath(request.resource.data.chatId))
              && getAfter(chatPath(request.resource.data.chatId)).data.members is list
              && request.auth.uid in getAfter(chatPath(request.resource.data.chatId)).data.members
              && uid in getAfter(chatPath(request.resource.data.chatId)).data.members
            )
            ||
            (
              request.resource.data.keys().hasOnly([
                'type', 'postId', 'postTitle', 'reaction', 'eventId', 'senderUid',
                'senderName', 'body', 'createdAt', 'isRead'
              ])
              && request.resource.data.type == 'post_like'
              && request.resource.data.postId is string
              && request.resource.data.postTitle is string
              && request.resource.data.reaction in [
                'like', '❤️', '😂', '😮', '😢', '😡', '🔥', '🎮', '👏'
              ]
              && request.resource.data.eventId is string
              && exists(postPath(request.resource.data.postId))
              && get(postPath(request.resource.data.postId)).data.uid == uid
              && request.resource.data.postTitle
                == (get(postPath(request.resource.data.postId)).data
                      .get('title', '') is string
                    && get(postPath(request.resource.data.postId)).data
                      .get('title', '') != ''
                    ? get(postPath(request.resource.data.postId)).data.title
                    : 'โพสต์ของคุณ')
              && exists(postReactionPath(
                request.resource.data.postId,
                request.auth.uid
              ))
              && get(postReactionPath(
                request.resource.data.postId,
                request.auth.uid
              )).data.uid == request.auth.uid
              && get(postReactionPath(
                request.resource.data.postId,
                request.auth.uid
              )).data.eventId == request.resource.data.eventId
              && notificationId == 'post_reaction_'
                + request.resource.data.postId + '_'
                + request.auth.uid + '_' + request.resource.data.eventId
              && request.resource.data.reaction
                == get(postReactionPath(
                  request.resource.data.postId,
                  request.auth.uid
                )).data.reaction
            )
            ||
            (
              request.resource.data.keys().hasOnly([
                'type', 'postId', 'joinRequestId', 'senderUid', 'senderName',
                'body', 'createdAt', 'isRead'
              ])
              && request.resource.data.type == 'join_request_received'
              && request.resource.data.postId is string
              && request.resource.data.joinRequestId is string
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid == uid
              && exists(/databases/$(database)/documents/users/$(uid)/joinRequests/$(request.resource.data.joinRequestId))
              && get(/databases/$(database)/documents/users/$(uid)/joinRequests/$(request.resource.data.joinRequestId)).data.ownerUid == uid
              && get(/databases/$(database)/documents/users/$(uid)/joinRequests/$(request.resource.data.joinRequestId)).data.senderUid == request.auth.uid
              && get(/databases/$(database)/documents/users/$(uid)/joinRequests/$(request.resource.data.joinRequestId)).data.postId == request.resource.data.postId
              && get(/databases/$(database)/documents/users/$(uid)/joinRequests/$(request.resource.data.joinRequestId)).data.status == 'pending'
            )
            ||
            (
              request.resource.data.keys().hasOnly([
                'type', 'postId', 'joinRequestId', 'senderUid', 'senderName',
                'body', 'createdAt', 'isRead'
              ])
              && request.resource.data.type == 'join_request_accepted'
              && request.resource.data.postId is string
              && request.resource.data.joinRequestId is string
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid == request.auth.uid
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.get('memberUids', []).hasAny([uid])
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/joinRequests/$(request.resource.data.joinRequestId))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)/joinRequests/$(request.resource.data.joinRequestId)).data.status == 'accepted'
              && get(/databases/$(database)/documents/users/$(request.auth.uid)/joinRequests/$(request.resource.data.joinRequestId)).data.senderUid == uid
              && get(/databases/$(database)/documents/users/$(request.auth.uid)/joinRequests/$(request.resource.data.joinRequestId)).data.postId == request.resource.data.postId
            )
            ||
            (
              request.resource.data.keys().hasOnly([
                'type', 'senderUid', 'senderName', 'body', 'createdAt', 'isRead'
              ])
              && request.resource.data.type == 'new_follower'
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.senderName is string
              && request.resource.data.body is string
              && request.resource.data.createdAt == request.time
              && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
              && !exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)).data.uid == request.auth.uid
            )
            ||
            (
              request.resource.data.keys().hasOnly([
                'type', 'postId', 'commentId', 'postTitle', 'senderUid',
                'senderName', 'body', 'createdAt', 'isRead'
              ])
              && request.resource.data.type == 'post_comment'
              && request.resource.data.postId is string
              && request.resource.data.commentId is string
              && request.resource.data.postTitle is string
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.senderName is string
              && request.resource.data.body is string
              && request.resource.data.createdAt == request.time
              && notificationId == 'post_comment_'
                + request.resource.data.postId + '_'
                + request.resource.data.commentId
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid == uid
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.uid == request.auth.uid
            )
            ||
            (
              request.resource.data.keys().hasOnly([
                'type', 'groupId', 'groupName', 'messageId', 'senderUid',
                'senderName', 'body', 'createdAt', 'isRead'
              ])
              && request.resource.data.type == 'group_chat_message'
              && request.resource.data.groupId is string
              && request.resource.data.groupName is string
              && request.resource.data.messageId is string
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.senderName is string
              && request.resource.data.body is string
              && request.resource.data.createdAt == request.time
              && notificationId == 'group_message_'
                + request.resource.data.groupId + '_'
                + request.resource.data.messageId + '_' + uid
              && exists(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId))
              && get(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId)).data.members is list
              && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId)).data.members
              && uid in get(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId)).data.members
              && exists(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId)/messages/$(request.resource.data.messageId))
              && get(/databases/$(database)/documents/groupChats/$(request.resource.data.groupId)/messages/$(request.resource.data.messageId)).data.uid == request.auth.uid
            )
          );

        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['isRead', 'readAt'])
          && request.resource.data.isRead == true;

        allow delete: if isOwner(uid);
      }

      // Requests to join a post are stored in the post owner's inbox.
      match /joinRequests/{requestId} {
        // The post owner manages the inbox; a sender can read only their own
        // requests so post cards can keep their status after refresh.
        allow get, list: if isOwner(uid)
          || (signedIn() && resource.data.senderUid == request.auth.uid);

        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'postId', 'postTitle', 'game', 'ownerUid', 'senderUid',
            'senderName', 'status', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'postId', 'postTitle', 'game', 'ownerUid', 'senderUid',
            'senderName', 'status', 'createdAt'
          ])
          && request.resource.data.ownerUid == uid
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid != uid
          && requestId == request.resource.data.postId + '_' + request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.postId is string
          && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
          && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid == uid;

        allow update: if (
          // Only the post owner can accept or decline a pending request.
          isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
        ) || (
          // Re-sending the same deterministic request ID may update a pending
          // request or reopen one that was declined, but cannot change its owner,
          // post, or sender.
          signedIn()
          && resource.data.ownerUid == uid
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.ownerUid == uid
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.status == 'pending'
          && resource.data.status in ['pending', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'postTitle', 'game', 'senderName', 'createdAt'])
          && postHasOpenSlot(get(/databases/$(database)/documents/posts/$(resource.data.postId)).data)
          && request.resource.data.createdAt == request.time
        );

        allow delete: if isOwner(uid);
      }

      // FCM registration tokens are private and must not be exposed by the
      // broad signed-in user-profile read rule above.
      match /devices/{deviceId} {
        allow get, list, create, update, delete: if isOwner(uid);
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(followerUid);
        allow update: if false;
      }

      match /following/{followingUid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // เอกสารห้องกลุ่มควบคุมรายชื่อสมาชิก ส่วน messages จำกัดให้อ่าน/เขียนโดยสมาชิก
    match /groupChats/{groupId} {
      // Keep the query constraints explicit so Firestore can prove each list
      // query is limited to the signed-in member or owner.
      allow list: if signedIn()
        && request.auth.uid in resource.data.members;
      allow list: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      // Direct document reads allow a member or the owner of legacy groups.
      allow get: if signedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members;
      allow get: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'name', 'ownerUid', 'members', 'memberNames', 'lastMessage',
          'lastSenderUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && request.resource.data.members.toSet().size() == request.resource.data.members.size()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberNames is map
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string;

      allow update: if signedIn()
        && (
          (
            resource.data.get('members', []) is list
            && request.auth.uid in resource.data.get('members', [])
          )
          || resource.data.get('ownerUid', '') == request.auth.uid
        )
        && request.resource.data.get('members', []) == resource.data.get('members', [])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt', 'hiddenBy'])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenBy'])
          || (request.resource.data.hiddenBy is list
            && request.resource.data.hiddenBy.size() == 0));

      // A member may hide a conversation from their own list. They can only
      // add their own UID; another member's visibility cannot be changed.
      allow update: if signedIn()
        && (
          (resource.data.get('members', []) is list
            && request.auth.uid in resource.data.get('members', []))
          || resource.data.get('ownerUid', '') == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy'])
        && request.resource.data.hiddenBy is list
        && resource.data.get('hiddenBy', []) is list
        && resource.data.get('hiddenBy', []).toSet()
          .difference(request.resource.data.hiddenBy.toSet()).size() == 0
        && request.resource.data.hiddenBy.toSet()
          .difference(resource.data.get('hiddenBy', []).toSet()).hasOnly([request.auth.uid]);

      // Current group members may invite registered users, while preserving
      // all existing members and names and respecting the 50-person limit.
      allow update: if signedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() > resource.data.members.size()
        && request.resource.data.members.size() <= 50
        && request.resource.data.members.toSet().size() == request.resource.data.members.size()
        && resource.data.members.toSet()
          .difference(request.resource.data.members.toSet()).size() == 0
        && request.resource.data.members.toSet()
          .difference(resource.data.members.toSet()).size()
          == request.resource.data.members.size() - resource.data.members.size()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberNames is map
        && resource.data.get('memberNames', {}) is map
        && request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).removedKeys().size() == 0
        && request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).changedKeys().size() == 0
        && request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).addedKeys()
          .hasOnly(request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberNames', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // A member may remove only their own UID. If the owner leaves, ownership
      // must move to a remaining member in the same atomic update.
      allow update: if signedIn()
        && resource.data.get('members', []) is list
        && request.auth.uid in resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && resource.data.members.toSet()
          .difference(request.resource.data.members.toSet())
          .hasOnly([request.auth.uid])
        && resource.data.members.toSet()
          .difference(request.resource.data.members.toSet())
          .hasAny([request.auth.uid])
        && request.resource.data.members.toSet()
          .difference(resource.data.members.toSet()).size() == 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'ownerUid', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          resource.data.get('ownerUid', '') == request.auth.uid
            ? request.resource.data.ownerUid == request.resource.data.members[0]
            : request.resource.data.ownerUid == resource.data.get('ownerUid', '')
        );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'type', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'text', 'type', 'createdAt', 'mediaUrl', 'fileName'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.type in ['text', 'image', 'video']
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.text.size() > 0
              && !request.resource.data.keys().hasAny(['mediaUrl'])
            )
            ||
            (
              request.resource.data.type in ['image', 'video']
              && request.resource.data.text == ''
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
            )
          )
          && (
            !request.resource.data.keys().hasAny(['fileName'])
            || request.resource.data.fileName is string
          );

        allow update: if false;
        // Any group member can clear the shared conversation history.
        allow delete: if isGroupMember(groupId);
      }
    }

    // โพสต์อ่านได้เมื่อ login; การสร้าง/แก้ไข/ลบและ reaction/comment ถูกจำกัดตามเจ้าของหรือกติกาเฉพาะ
    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if signedIn() && (
        (
          resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
        )
        ||
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount'])
          && resource.data.commentCount is int
          && request.resource.data.commentCount is int
          && request.resource.data.commentCount == resource.data.commentCount + 1
        )
        ||
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['commentCount', 'lastCommentDeletion'])
          && resource.data.commentCount is int
          && request.resource.data.commentCount is int
          && request.resource.data.commentCount >= 0
          && request.resource.data.commentCount == resource.data.commentCount - 1
          && request.resource.data.lastCommentDeletion is string
          && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentDeletion))
          && !existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentDeletion))
          && (
            get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentDeletion)).data.uid == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentDeletion)).data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
          )
        )
        ||
        (
          signedIn()
          && resource.data.uid != request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['joinRequestUids'])
          && resource.data.get('joinRequestUids', []) is list
          && request.resource.data.joinRequestUids is list
          && request.resource.data.joinRequestUids.size()
            == resource.data.get('joinRequestUids', []).size() + 1
          && request.resource.data.joinRequestUids.toSet().size()
            == request.resource.data.joinRequestUids.size()
          && request.resource.data.joinRequestUids.toSet()
            .difference(resource.data.get('joinRequestUids', []).toSet())
            .hasOnly([request.auth.uid])
          && resource.data.get('joinRequestUids', []).toSet()
            .difference(request.resource.data.joinRequestUids.toSet()).size() == 0
          && postHasOpenSlot(resource.data)
          && existsAfter(/databases/$(database)/documents/users/$(resource.data.uid)/joinRequests/$(postId + '_' + request.auth.uid))
          && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)/joinRequests/$(postId + '_' + request.auth.uid)).data.ownerUid == resource.data.uid
          && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)/joinRequests/$(postId + '_' + request.auth.uid)).data.senderUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)/joinRequests/$(postId + '_' + request.auth.uid)).data.postId == postId
          && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)/joinRequests/$(postId + '_' + request.auth.uid)).data.status == 'pending'
        )
        || validPostReaction()
      );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      // A reaction is stored in a per-user document, so reacting to another
      // user's post never requires permission to edit the post itself.
      match /reactions/{userId} {
        allow read: if signedIn();

        allow create: if validPostReactionWrite(postId, userId);
        allow update: if validPostReactionWrite(postId, userId)
          && request.resource.data.reaction != resource.data.reaction;

        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;

        allow update: if signedIn()
          && resource.data.uid == request.auth.uid;

        allow delete: if signedIn() && (
          resource.data.uid == request.auth.uid
          || resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid
        );
      }
    }

    match /messages/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // Reports are private to their reporter. A deterministic ID allows one
    // report per account per post while preventing users from replacing it.
    // รายงานอ่านรายการได้เฉพาะแอดมิน และผู้ใช้สร้างรายงานของตนเองได้ครั้งเดียวต่อโพสต์
    match /reports/{reportId} {
      allow get: if isAdmin() || (signedIn()
        && (!exists(/databases/$(database)/documents/reports/$(reportId))
          || resource.data.reporterUid == request.auth.uid));
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'deleted']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'postId', 'reporterUid', 'reason', 'createdAt', 'status',
          'postOwnerUid', 'postOwnerName', 'postText', 'reporterName'
        ])
        && request.resource.data.postId is string
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in [
          'เนื้อหาไม่เหมาะสม', 'สแปมหรือโฆษณา', 'ใช้ถ้อยคำไม่สุภาพ', 'เหตุผลอื่น ๆ'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending'
        && exists(postPath(request.resource.data.postId))
        && get(postPath(request.resource.data.postId)).data.uid != request.auth.uid
        && request.resource.data.postOwnerUid == get(postPath(request.resource.data.postId)).data.uid;

      allow update, delete: if false;
    }
  }
}
